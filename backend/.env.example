PORT=4100
# In production this should be the dashboard's domain — comma-separate more than one origin if needed.
CORS_ORIGIN=https://app.boxandbeyondservices.in,http://localhost:5500

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for verifying the Nextopper webhook's HMAC signature.
# PLACEHOLDER — confirm the real signing scheme with Nextopper before going live.
NEXTOPPER_WEBHOOK_SECRET=

# DTDC API credentials.
# PLACEHOLDER — confirm the real base URL / auth scheme with DTDC before going live.
DTDC_API_BASE_URL=
DTDC_API_KEY=
DTDC_CUSTOMER_CODE=

# Set to "true" for local/staging testing without real DTDC credentials — see
# lib/dtdc.js's mock mode. NEVER set this to true in production.
DTDC_MOCK=false

# How often (minutes) the background job polls DTDC for tracking updates.
DTDC_SYNC_INTERVAL_MINUTES=15

# How often (minutes) the background job books DTDC shipments for orders the
# webhook has received but not yet shipped. Kept low — this is the
# time-sensitive step, decoupled from webhook traffic on purpose (see
# routes/webhooks.js and jobs/processBookings.js).
DTDC_BOOKING_INTERVAL_MINUTES=1
